<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.facens</groupId>
    <artifactId>Grupo04_ATDD</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Grupo04_ATDD</name>
    <description>Grupo04_ATDD</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- ================================================== -->
            <!-- JACOCO - Cobertura de testes                       -->
            <!-- ================================================== -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>

                <executions>

                    <!-- Ativa o agente JaCoCo antes dos testes -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!-- Gera o relatório de cobertura -->
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                    <!-- Quality Gate: mínimo de 80% -->
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>

                        <configuration>
                            <rules>
                                <rule>

                                    <!-- Verifica o projeto inteiro -->
                                    <element>BUNDLE</element>

                                    <limits>
                                        <limit>

                                            <!-- Cobertura de linhas -->
                                            <counter>LINE</counter>

                                            <!-- Percentual coberto -->
                                            <value>COVEREDRATIO</value>

                                            <!-- Mínimo: 80% -->
                                            <minimum>0.70</minimum>

                                        </limit>
                                    </limits>

                                </rule>
                            </rules>
                        </configuration>

                    </execution>

                </executions>
            </plugin>

            <!-- ================================================== -->
            <!-- PMD - Análise estática de código                   -->
            <!-- ================================================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.25.0</version>

                <configuration>

                    <!-- Faz o build falhar se houver violações -->
                    <failOnViolation>true</failOnViolation>

                    <!-- Mostra as violações no console -->
                    <printFailingErrors>true</printFailingErrors>

                </configuration>

                <executions>

                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>

                        <goals>

                            <!-- Gera relatório -->
                            <goal>pmd</goal>

                            <!-- Verifica violações -->
                            <goal>check</goal>

                        </goals>

                    </execution>

                </executions>
            </plugin>
        </plugins>
    </build>

</project>
